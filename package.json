{
  "name": "kept",
  "version": "0.1.0",
  "private": true,
  "description": "Kept — the operating system for execution. Plan it, do it, prove it.",
  "scripts": {
    "dev": "next dev --port 3100",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:migrate": "node --env-file-if-exists=.env.local --conditions=react-server --import tsx scripts/db.ts migrate",
    "db:seed": "node --env-file-if-exists=.env.local --conditions=react-server --import tsx scripts/db.ts seed",
    "db:reset": "node --env-file-if-exists=.env.local --conditions=react-server --import tsx scripts/db.ts reset"
  },
  "dependencies": {
    "@electric-sql/pglite": "0.5.8",
    "@phosphor-icons/react": "2.1.10",
    "motion": "13.4.4",
    "next": "16.3.6",
    "pg": "8.23.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "sharp": "0.35.4",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "24",
    "@types/pg": "8",
    "@types/react": "19",
    "@types/react-dom": "19",
    "postcss": "8.5.23",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "5.0.2"
  }
}
